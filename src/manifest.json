{
    "name": "Unngå UBW",
    "version": "1.2.0",
    "description": "Fyll ut timelisten i UBW, PowerOffice eller SAP med timer fra Toggl",
    "manifest_version": 3,
    "permissions": [ "storage" ],
    "host_permissions": [ "https://api.track.toggl.com/*" ],
    "background": {
        "scripts": [ "toggl_api.js", "bakgrunn.js" ],
        "service_worker": "bakgrunn.js"
    },
    "options_ui": {
        "page": "tilvalg.html",
        "open_in_tab": true
    },
    "content_scripts": [
        {
            "matches": [ "https://ubw.unit4cloud.com/*", "https://aspagresso.public.cloudservices.no/*" ],
            "js": [ "rader.js", "toggl_til_tsv.js", "utvalg.js", "oppforinger.js", "timeliste.js", "uubw.js", "fyll_fra_toggl.js" ]
        },
        {
            "matches": [ "https://go.poweroffice.net/*" ],
            "js": [ "rader.js", "utvalg.js", "oppforinger.js", "poweroffice.js", "poweroffice_api.js", "fyll_poweroffice.js" ]
        },
        {
            "matches": [ "https://go.poweroffice.net/*" ],
            "js": [ "poweroffice_side.js" ],
            "world": "MAIN",
            "run_at": "document_start"
        },
        {
            "matches": [ "https://*.sapbydesign.com/*" ],
            "js": [ "rader.js", "utvalg.js", "oppforinger.js", "sap.js", "fyll_sap.js" ]
        },
        {
            "matches": [ "https://*.sapbydesign.com/*" ],
            "js": [ "sap_side.js" ],
            "world": "MAIN"
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "{45b5a403-d1a4-4fdf-b963-f59e2fdd134d}",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": [ "authenticationInfo" ]
            }
        },
        "gecko_android": {
            "strict_min_version": "142.0"
        }
    }
}
